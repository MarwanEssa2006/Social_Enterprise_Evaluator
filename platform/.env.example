# Copy to .env.local and fill in. Never commit real values.

# AI mode: "mock" (default when no key) or "gemini".
AI_MODE=mock
# Gemini API key — server-side only. Use a paid (billing-linked) Google Cloud project before any real data (TD-16, D-39).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage locations (relative to the platform/ folder)
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
EXCEL_TEMPLATE_PATH=assets/alan-template.xlsx

# Set to 1 only when running a production build over plain HTTP locally (cookies are otherwise Secure in production).
INSECURE_COOKIES=
